{
  "name": "@eslint-react/eslint-plugin",
  "version": "5.28.8",
  "description": "ESLint React's unified ESLint plugin that combines all individual plugins into one.",
  "keywords": [
    "react",
    "eslint",
    "eslint-react",
    "eslint-plugin",
    "eslint-plugin-react-x",
    "eslint-plugin-react-jsx",
    "eslint-plugin-react-rsc",
    "eslint-plugin-react-dom",
    "eslint-plugin-react-web-api",
    "eslint-plugin-react-naming-convention",
    "@eslint-react/eslint-plugin"
  ],
  "homepage": "https://github.com/Rel1cx/eslint-react",
  "bugs": {
    "url": "https://github.com/Rel1cx/eslint-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rel1cx/eslint-react.git",
    "directory": "plugins/eslint-plugin"
  },
  "license": "MIT",
  "author": "Rel1cx",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@eslint-react/shared": "5.28.8",
    "eslint-plugin-react-dom": "5.28.8",
    "eslint-plugin-react-jsx": "5.28.8",
    "eslint-plugin-react-naming-convention": "5.28.8",
    "eslint-plugin-react-rsc": "5.28.8",
    "eslint-plugin-react-web-api": "5.28.8",
    "eslint-plugin-react-x": "5.28.8"
  },
  "devDependencies": {
    "@local/configs": "0.0.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dedent": "^1.7.2",
    "eslint": "^10.13.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "*",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "inlinedDependencies": {
    "@local/eff": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "lint:publish": "publint",
    "lint:ts": "tsl"
  }
}